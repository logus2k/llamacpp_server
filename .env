# ---------------------------------------------------------------------------
# llama.cpp server on Intel Arc (SYCL / Level Zero) — configuration
# Sourced by scripts/common.sh. Everything here is optional; defaults shown.
# ---------------------------------------------------------------------------

# Official llama.cpp SYCL build (Intel GPU).
IMAGE="ghcr.io/ggml-org/llama.cpp:server-intel"
CONTAINER_NAME="llamacpp-arc"

# Host port for the OpenAI-compatible API + web UI.
PORT="8080"

# Filename of the .gguf inside ./models. Leave empty to auto-detect
# (works when exactly one model is present; sharded models: point at shard 1).
MODEL="gemma-4-E4B-it-UD-Q4_K_XL.gguf"

# 99 = offload every layer to the GPU. Lower it to split with the CPU.
N_GPU_LAYERS="99"

# Context window. The Arc 140V shares system RAM, so this competes with
# the model weights for the ~15 GiB this WSL instance has.
CTX_SIZE="4096"

# CPU threads used for the non-offloaded work.
THREADS="4"

# Appended verbatim to llama-server. Useful additions:
#   --jinja                 use the model's own chat template (needed for tool calls)
#   --api-key <secret>      require an Authorization header
#   -fa on                  force flash-attention
EXTRA_ARGS=""

# --- Speculative decoding -------------------------------------------------
# Comma-separated modes; empty or "none" disables it. Options:
#   ngram-simple, ngram-mod, ngram-map-k, ngram-map-k4v, ngram-cache
#       predict from n-grams already in the context — NO draft model needed,
#       no extra memory. Big wins when output repeats the input (editing,
#       summarising, refactoring); little or nothing on open-ended prose.
#   draft-simple
#       classic draft model; also set SPEC_DRAFT_MODEL. The draft must share
#       the target's tokenizer (here: a "gemma4" architecture model).
SPEC_TYPE="draft-mtp"

# Draft model filename in ./models (only for draft-* modes).
SPEC_DRAFT_MODEL="mtp-gemma-4-E4B-it.gguf"

# GPU layers for the draft model, and how many tokens to speculate per step.
SPEC_DRAFT_NGL="99"
SPEC_DRAFT_N_MAX=""

# --- Vision (multimodal) --------------------------------------------------
# Multimodal projector filename in ./models. Set this to accept images via
# the API's image_url content parts. Leave empty for text-only.
MMPROJ="mmproj-F16.gguf"
